; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Hunter Life"
config/version="0.1.2-test"
run/max_fps.android=60
run/main_scene="res://main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Hunter Life Prototype"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Audio="*res://scripts/audio_manager.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=860
window/size/window_width_override=480
window/size/window_height_override=860
window/size/mode.android=3
window/size/viewport_width.android=360
window/size/viewport_height.android=780
window/stretch/mode.android="canvas_items"
window/stretch/aspect.android="expand"
window/handheld/orientation=1

[editor]

import/use_multiple_threads=false

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.945098, 0.909804, 0.843137, 1)
